lookup SingleSubstitutioninArabiclookupHaBulat {
  lookupflag RightToLeft IgnoreMarks;
    sub \ha_bulat by \ha_bulat.isol ;
} SingleSubstitutioninArabiclookupHaBulat;

lookup isolIsolatedFormsinArabiclookup13 {
  lookupflag 0;
    @cc22_match_1 = [\ha_bulat ];
    @cc22_match_2 = [\ttx2xa ];
    @cc22_match_3 = [\ha_bulat.isol ];
    @cc22_back_1 = [\ha_bulat ];
    @cc22_back_2 = [\ttx2xa ];
    @cc22_back_3 = [\ha_bulat.isol ];
    @cc22_ahead_1 = [\ha_bulat ];
    @cc22_ahead_2 = [\ttx2xa ];
    @cc22_ahead_3 = [\ha_bulat.isol ];
    sub @cc22_match_1'lookup SingleSubstitutioninArabiclookupHaBulat  @cc22_ahead_2 ;
    sub [\hamzah \uni0624 \uni0626 \alif \uni0639.fina \uni062F.fina \uni062F.isol 
	\ha_pedas.fina \uni06A9.fina \lam.fina \mim.fina \uni0631.fina 
	\sod.fina \uni0633.fina \uni0637.fina \uni0648.fina \uni0649.fina 
	\uni06A1.fina \uni06BA.fina \uni066F.fina \lillah \kaf.arab.fina 
	\kaf.swsh.fina ] [\ha_bulat ]'lookup SingleSubstitutioninArabiclookupHaBulat  ;
} isolIsolatedFormsinArabiclookup13;

lookup finaTerminalFormsSinglePos {
  lookupflag RightToLeft;
    sub \mim by \mim.fina ;
    sub \ha_bulat by \ha_bulat.fina ;
    sub \ye_maksurah by \uni0649.fina ;
} finaTerminalFormsSinglePos;

lookup mediMedialFormsSinglePos {
  lookupflag RightToLeft;
    sub \mim by \mim.medi ;
    sub \ha_bulat by \ha_bulat.medi ;
    sub \ye_maksurah by \uni066E.medi ;
} mediMedialFormsSinglePos;

lookup initInitialFormsSinglePos {
  lookupflag RightToLeft;
    sub \mim by \mim.init ;
    sub \ha_bulat by \ha_bulat.init ;
    sub \ye_maksurah by \uni066E.init ;
} initInitialFormsSinglePos;

lookup finaArabicTerminalForms {
  lookupflag RightToLeft;
    sub \alif by \alif.fina ;
    sub \ha_pedas by \ha_pedas.fina ;
