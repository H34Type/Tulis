    sub \sod by \sod.fina ;
    sub \ain by \uni0639.fina ;
    sub \lam by \lam.fina ;
    sub \wau by \uni0648.fina ;
    sub \kaf by \uni06A9.fina ;
    sub \uni066E by \uni066E.fina ;
    sub \uni06A1 by \uni06A1.fina ;
    sub \uni06BA by \uni06BA.fina ;
    sub \uni066F by \uni066F.fina ;
    sub \uni06A1.ss01 by \uni06A1.ss01.fina ;
    sub \mim.ss01 by \mim.ss01.fina ;
    sub \uni0647.ss01 by \uni0647.ss01.fina ;
    sub \uni0648.ss01 by \uni0648.ss01.fina ;
    sub \uni066F.ss01 by \uni066F.ss01.fina ;
    sub \nya by \uni06BA.fina \ttx3xa ;
    sub \ta_bulat by \ha_bulat.fina \ttx2xa ;
    sub \kaf.arab by \kaf.arab.fina ;
    sub \kaf.swsh by \kaf.swsh.fina ;
} finaArabicTerminalForms;

lookup mediArabicMedialForms {
  lookupflag RightToLeft;
    sub \ha_pedas by \ha_pedas.medi ;
    sub \sin by \uni0633.medi ;
    sub \sod by \sod.medi ;
    sub \ain by \uni0639.medi ;
    sub \lam by \lam.medi ;
    sub \kaf by \uni06A9.medi ;
    sub \uni066E by \uni066E.medi ;
    sub \uni06A1 by \uni06A1.medi ;
    sub \uni06BA by \uni066E.medi ;
    sub \uni066F by \uni06A1.medi ;
    sub \uni06A1.ss01 by \uni06A1.ss01.medi ;
    sub \mim.ss01 by \mim.ss01.medi ;
    sub \uni0647.ss01 by \uni0647.ss01.medi ;
    sub \uni066F.ss01 by \uni066F.ss01.medi ;
    sub \nya by \uni066E.medi \ttx3Axb ;
    sub \kaf.arab by \uni06A9.medi ;
    sub \kaf.swsh by \kaf.swsh.medi ;
} mediArabicMedialForms;

