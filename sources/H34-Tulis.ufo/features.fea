lookup swshKafSwash {
  lookupflag RightToLeft;
    sub \kaf by \kaf.swsh ;
    sub \uni06A9.fina by \kaf.swsh.fina ;
    sub \uni06A9.init by \kaf.swsh.init ;
    sub \uni06A9.medi by \kaf.swsh.medi ;
    sub \kaf.arab by \kaf.swsh ;
    sub \kaf.arab.fina by \kaf.swsh.fina ;
    sub \kaf.init_pndk by \padam ;
    sub \kaf.init_pnjg by \padam ;
    sub \kaf.medi_pndk by \padam ;
    sub \kaf.medi_pnjg by \padam ;
} swshKafSwash;

