# GDEF Mark Attachment Classes
@tt_atas=[\ttx1xa \ttx2xa \ttx3xa \ttx3Axa \ttx4xa \ttx2Axa ];
@tt_bawah=[\ttx1xb \ttx2xb \ttx3xb \ttx3Axb \ttx4xb \ttx2Axb ];

languagesystem DFLT dflt;
languagesystem arab dflt;
languagesystem arab URD ;
languagesystem cyrl dflt;
languagesystem latn dflt;


# GSUB 


lookup isolMultipleIsolatedFormslookup0 {
  lookupflag 0;
    sub \nya by \uni06BA \ttx3xa ;
} isolMultipleIsolatedFormslookup0;

lookup ccmpGabungCincinDot {
  lookupflag 0;
    sub \hamzahKecilAtas by \uni25CC \hamzahKecilAtas ;
    sub \hamzahKecilBawah by \uni25CC \hamzahKecilBawah ;
    sub \toKecilBawah by \uni25CC \toKecilBawah ;
    sub \toKecilAtas by \uni25CC \toKecilAtas ;
    sub \cincinKecil by \uni25CC \cincinKecil ;
    sub \ttx1xb by \uni25CC \ttx1xb ;
    sub \ttx2xb by \uni25CC \ttx2xb ;
    sub \ttx3xb by \uni25CC \ttx3xb ;
    sub \ttx4xb by \uni25CC \ttx4xb ;
    sub \ttx2Axb by \uni25CC \ttx2Axb ;
    sub \ttx3Axb by \uni25CC \ttx3Axb ;
    sub \ttx1xa by \uni25CC \ttx1xa ;
    sub \ttx2xa by \uni25CC \ttx2xa ;
    sub \ttx3xa by \uni25CC \ttx3xa ;
    sub \ttx4xa by \uni25CC \ttx4xa ;
    sub \ttx2Axa by \uni25CC \ttx2Axa ;
    sub \ttx3Axa by \uni25CC \ttx3Axa ;
} ccmpGabungCincinDot;

lookup ccmpGabungBentuk {
  lookupflag 0;
    sub \uniFEFB by \lam.init \alif.fina ;
    sub \uniFEFC by \lam.medi \alif.fina ;
    sub \alif-hamzahAtas by \alif \hamzahKecilAtas ;
    sub \alif-hamzahBawah by \alif \hamzahKecilBawah ;
} ccmpGabungBentuk;

